# ECPC Analytics — Environment Configuration
# Copy this file to .env and fill in the values.
# .env is gitignored and should NEVER be committed.

# Flask
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-me-to-a-random-secret-string

# CORS — comma-separated list of allowed origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5000

# Server
HOST=0.0.0.0
PORT=5000

# Logging — DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Admin — required to call /api/refresh
ADMIN_API_KEY=change-me-to-a-random-admin-key

# Rate limiting — e.g. "60/minute", "100/hour"
RATE_LIMIT=60/minute
